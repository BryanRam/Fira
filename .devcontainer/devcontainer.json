{
  "name": "Fira",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "runServices": ["dev", "neo4j"],
  "workspaceFolder": "/workspaces/Fira",
  "shutdownAction": "stopCompose",

  // "node" is UID 1000 (the default WSL user). On Linux/WSL hosts the UID is
  // also remapped to match the host user so bind-mounted files are never
  // root-owned.
  "remoteUser": "node",
  "updateRemoteUserUID": true,

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Lets you build/run the production images (root docker-compose.yml)
    // using the host's Docker engine.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [3000, 5173, "neo4j:7474", "neo4j:7687"],
  "portsAttributes": {
    "3000": { "label": "API" },
    "5173": { "label": "Web (Vite)" },
    "neo4j:7474": { "label": "Neo4j Browser" },
    "neo4j:7687": { "label": "Neo4j Bolt" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "Vue.volar",
        "oven.bun-vscode",
        "vitest.explorer",
        "neo4j-extensions.neo4j-for-vscode",
        "ms-azuretools.vscode-containers",
        "github.vscode-github-actions",
        "EditorConfig.EditorConfig",
        "mikestead.dotenv"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "files.eol": "\n"
      }
    }
  }
}
